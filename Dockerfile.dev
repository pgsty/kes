# Development build from this checkout, not a download of the upstream tree.
FROM golang:1.27.2-alpine AS build
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /kes ./cmd/kes

FROM scratch
LABEL org.opencontainers.image.title="PGSTY KES" \
      org.opencontainers.image.vendor="PGSTY" \
      org.opencontainers.image.source="https://github.com/pgsty/kes" \
      org.opencontainers.image.licenses="AGPL-3.0-only"
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=build /kes /kes
COPY LICENSE CREDITS NOTICE /licenses/
USER 1000:1000
EXPOSE 7373
ENTRYPOINT ["/kes"]
CMD ["--help"]
